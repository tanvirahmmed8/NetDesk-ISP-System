DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=isp_system

# Required for /mcp/v1. Generate a random secret of at least 32 characters.
MCP_API_KEY=
# Browser origins allowed to call MCP; no wildcard.
MCP_ALLOWED_ORIGINS=http://localhost:3008,http://127.0.0.1:3008

# Dashboard login: run db:migrate:auth then auth:create-user -- admin.
# Blank = Secure cookies in production, normal cookies in development.
# Only use false for local HTTP production-build testing, never public hosting.
AUTH_COOKIE_SECURE=

# Optional canonical public origin for login redirects behind a reverse proxy.
# Leave blank locally. The production deploy script sets the NetDesk domain.
NETDESK_PUBLIC_URL=
